{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "jti": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "description": "The link's jti: 16 random bytes as 32 lower-case hex characters"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "When the link expires, from its exp, so its jti is kept that long"
    }
  },
  "required": [
    "jti",
    "expires_at"
  ],
  "title": "Marking a login link used: POST /geekykey/v1/used-login-links"
}
