{
  "name": "@geekykey/event-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch scripts/dev-server.ts",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke-test.ts",
    "build": "rolldown src/server.ts --platform node --format cjs --sourcemap --file dist/server.cjs",
    "build:image": "docker build --file Dockerfile --tag geekykey-event-service ../..",
    "typecheck": "tsc",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:migrations": "node scripts/check-migrations.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.ts",
    "db:logins": "node scripts/create-logins.ts",
    "db:test-station": "node scripts/create-test-station.ts",
    "seed": "node scripts/seed.ts"
  },
  "dependencies": {
    "@geekykey/firebase-login": "workspace:*",
    "@geekykey/handoff": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "0.73.0",
    "oxlint": "1.87.0",
    "rolldown": "1.2.14",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
