// Formatter settings, as in the frontend: every option not set here is oxfmt's default. Files
// git ignores, such as the bundle in dist/, are skipped without being listed.
{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    // drizzle-kit rewrites these in its own style on every generate.
    "drizzle/",
  ],
}
