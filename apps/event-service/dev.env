# Settings for `pnpm dev` (`mise run dev:event-service`) on your laptop. None
# is a secret, so this file is committed, and a fresh clone runs without a .env.
#
# Your own .env, if you have one, overrides this file, and a variable set in
# your shell overrides both. Production's settings live on Cloud Run.

# Adds POST /auth/dev-login, which signs in a seeded user without the portal,
# and signs sessions with a built-in secret. Never true in production.
DEV_AUTH_ENABLED=true

# Port 8001, since the GeekyKey Service's `wrangler dev` holds 8000, where
# stations point. Cloud Run sets PORT itself.
PORT=8001

# The TiDB from `mise run db:up`. The login only works on this machine.
DATABASE_URL=mysql://geekykey:geekykey@127.0.0.1:4000/geekykey_dev
