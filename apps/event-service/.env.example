# Your own settings and secrets for `pnpm dev`. Copy this file to .env, which
# git ignores. Lines here override dev.env, and a variable set in your shell
# overrides both. Never put a secret in dev.env, which is committed.

# Signs the event_session cookie. Locally it can stay unset, because dev-login
# signs with a built-in secret. Set it if you turn DEV_AUTH_ENABLED off, or
# the server won't start. Production's lives in Secret Manager.
# SESSION_SECRET=

# The key the GeekyKey Service's requests to the claims stand-in carry. Locally
# it can stay unset too, for the same reason. If you set it, make it 64 hex
# characters, as `openssl rand -hex 32` writes them, and set the same in the
# GeekyKey Service's dev.env. Production's lives in Secret Manager.
# CLAIMS_STAND_IN_KEY=

# The key the GeekyKey Service's hand-offs to the Event side carry, the Event
# Service key. The same rules as CLAIMS_STAND_IN_KEY.
# EVENT_SERVICE_KEY=

# 0 lets repeat taps at the same station count while you test.
# TAP_COOLDOWN_SECONDS=0
