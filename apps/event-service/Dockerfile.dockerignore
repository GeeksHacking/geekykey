# What apps/event-service/Dockerfile's build sees of the repo. Everything is
# left out, then only what the image needs is let back in, so no local secret
# such as a .env can end up in it.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!apps/event-service/package.json
!apps/event-service/tsconfig.json
!apps/event-service/src/
apps/event-service/src/**/*.test.ts
apps/event-service/src/test-helpers.ts
!packages/handoff/package.json
!packages/handoff/src/
packages/handoff/src/**/*.test.ts
!packages/firebase-login/package.json
!packages/firebase-login/src/
packages/firebase-login/src/**/*.test.ts
packages/firebase-login/src/testing.ts
