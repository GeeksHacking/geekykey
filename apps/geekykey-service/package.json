{
  "name": "@geekykey/geekykey-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env-file dev.env --var DEV_AUTH_ENABLED:true",
    "test": "vitest run",
    "typecheck": "wrangler types && tsc",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:build": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@geekykey/handoff": "workspace:*",
    "@hono/zod-validator": "^0.7.6",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.87.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.0"
  }
}
