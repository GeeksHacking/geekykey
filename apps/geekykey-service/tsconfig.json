{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // The Workers runtime's types come from worker-configuration.d.ts, which
    // `wrangler types` writes from wrangler.jsonc, and the tests' from the
    // Vitest plugin.
    "types": ["@cloudflare/vitest-plugin/types"],
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["worker-configuration.d.ts", "src", "test-support", "vitest.config.ts"]
}
