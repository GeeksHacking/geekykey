// The GeekyKey Service as a Cloudflare Worker, with no database (the migration
// spec's 5.1). `wrangler dev` runs it locally on workerd, the runtime
// Cloudflare runs in production.
//
// Settings live here and change through a reviewed pull request. This file is
// the source of truth: a deploy overwrites settings and routes changed in the
// Cloudflare dashboard. Secrets never live here: locally `pnpm dev` reads
// stand-ins from the committed dev.env, and in production Julian sets them on
// the Worker itself.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker Julian created on 1 Oct 2026, which holds key-api.
  "name": "geekykey-service",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-12",
  // Wrangler sends anonymous usage data unless told not to.
  "send_metrics": false,

  // No workers.dev address and no preview URLs: the custom domain below is
  // the only way in.
  "workers_dev": false,
  "preview_urls": false,

  // The address stations call. Julian attached it in the dashboard first.
  // It's listed here too, so a deploy keeps it.
  "routes": [{ "pattern": "key-api.geekshacking.com", "custom_domain": true }],

  // Secrets the Worker can't start without: a deploy fails if one isn't set
  // on the Worker, and src/config.ts stops it starting without one. Each
  // Event Service in EVENT_SERVICES has its own key, named after its ID, so
  // adding one adds its key here too. Listing them also changes `wrangler
  // dev`: from dev.env it takes only these and the settings under `vars`,
  // and ignores anything else.
  "secrets": {
    "required": ["SESSION_SECRET", "CLAIMS_STAND_IN_KEY", "EVENT_SERVICE_KEY_SHOWCASE"],
  },

  // Logs every request, with its CPU time, to Workers Logs. New Workers have
  // this on anyway, but the log check at checkpoint 4 depends on it, so it's
  // written down rather than left to a default.
  "observability": {
    "enabled": true,
  },

  // The rate limits (the API agreement's section 2, "Rate limits"; the
  // migration spec's 5.1). We chose 7101 to 7103 ourselves (BAC-67).
  // Bindings that share a namespace_id on one account share a count only
  // for the same key, and our keys are hashes and IDs no other Worker
  // sends, so another Worker's use of these IDs wouldn't touch ours. Each
  // namespace_id is a positive integer written as a string, and the period
  // is 10 or 60 seconds. Cloudflare counts in each data centre, and only
  // approximately (src/rate-limit.ts). Locally, Wrangler simulates them.
  "ratelimits": [
    // Each station's requests, taps and heartbeats together, by the SHA-256
    // of the key it sent, counted before the key is checked.
    {
      "name": "STATION_LIMIT",
      "namespace_id": "7101",
      "simple": { "limit": 60, "period": 60 },
    },
  ],

  // Where stations already point. Every network interface, not only
  // localhost, because real stations call this laptop by name, such as
  // http://A-Mac.local:8000. The Event Service runs on 8001.
  "dev": {
    "ip": "0.0.0.0",
    "port": 8000,
  },

  "vars": {
    // The Event Services whose stations this Worker takes taps from, and
    // hands them to: an ID, a name, and an https:// address with no / at the
    // end. `public_url`, which may be left out, is where its screens are, for
    // the buttons on the token page and My tokens. Locally, dev.env points the
    // showcase at http://localhost:8001, and its screens at 5173.
    "EVENT_SERVICES": [
      {
        "id": "showcase",
        "name": "Capstone Showcase",
        "url": "https://event-api.geekshacking.com",
        "public_url": "https://event.geekshacking.com",
      },
    ],
    // Who owns each token, until the switch to the Portal's tag APIs.
    "CLAIMS_STAND_IN_URL": "https://event-api.geekshacking.com/claims-stand-in/v1",
    // User IDs who may release someone else's token: Firebase UIDs. Adam's
    // Google account for now; Ethan's and Zi Tao's join with the lists for
    // the day at checkpoint 8.
    "GEEKYKEY_ADMINS": ["qxcUTVjDfgaK7FL1R3UAJmPW9Up2"],
    // The most tokens one user may hold. Nobody is exempt, GeekyKey admins
    // included.
    "MAX_TOKENS_PER_USER": 3,
    "MAX_TAPS_PER_REQUEST": 500,
    // One deadline for a station request's calls out (the API agreement's
    // 11.5). The station waits 5 seconds.
    "TAP_DEADLINE_MS": 4000,
    // The Firebase project whose ID tokens POST /auth/firebase accepts, the
    // same as the Event Service's (ADR 0004). Not a secret: the screens name
    // it too.
    "FIREBASE_PROJECT_ID": "geekykey-b035a",
    // No DEV_AUTH_ENABLED, which adds POST /auth/dev-login: unset is off.
    // Locally `pnpm dev` turns it on with `wrangler dev --var`.
  },
}
