# Firebase's web config, from section 7.2 of the API agreement. None of the three is
# secret: the API key only names the project, and Firebase allows sign-in only from the
# authorised domains in step 14 of infra/README.md: localhost, key.geekshacking.com,
# event.geekshacking.com and Firebase's own two.
#
# This file is committed so a fresh clone can sign in with Google straight after
# `mise run dev`. A variable in your shell wins over it, and so does your own
# .env.local, so a different Firebase project needs no change to this file.
VITE_FIREBASE_API_KEY=AIzaSyDw6Xhurpkj5pFu-qmxjkySBPZm2K8Xhpc
VITE_FIREBASE_PROJECT_ID=geekykey-b035a
VITE_FIREBASE_APP_ID=1:468223998400:web:19878ad2672a1c7116b025
