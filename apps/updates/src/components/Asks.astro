---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  asks: { who: string; what: string }[];
  /** 2 on an entry page. 3 on the home page, where it sits under the entry's h2. */
  level?: 2 | 3;
}

const { asks, level = 2, class: className, ...rest } = Astro.props;
const Heading = level === 2 ? "h2" : "h3";
---

<section
  aria-labelledby="asks-title"
  class:list={[
    "relative rounded-lg border border-border bg-card py-5 pl-8 pr-5 md:py-6 md:pl-10 md:pr-6",
    className,
  ]}
  {...rest}
>
  <span
    aria-hidden="true"
    class="absolute bottom-5 left-4 top-5 w-1.5 rounded-md border border-primary-edge bg-primary md:bottom-6 md:left-5 md:top-6"
  ></span>
  <Heading id="asks-title" class="font-semibold">What we need</Heading>
  <ul class="mt-3 divide-y divide-border">
    {
      asks.map((ask) => (
        <li class="grid gap-x-6 gap-y-1 py-3 first:pt-0 last:pb-0 md:grid-cols-[8rem_minmax(0,1fr)]">
          <p class="font-medium">{ask.who}</p>
          <p>{ask.what}</p>
        </li>
      ))
    }
  </ul>
</section>
