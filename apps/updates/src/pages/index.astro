---
import Asks from "../components/Asks.astro";
import Schedule from "../components/Schedule.astro";
import Base from "../layouts/Base.astro";
import { getEntries, type Entry } from "../lib/entries";
import { formatList, formatRange, isoDay } from "../lib/format";
import { TEAM } from "../lib/project";

const entries = await getEntries();
const [latest, ...earlier] = entries;

// Earlier entries grouped by sprint. getEntries() is newest first, so the groups are too.
const groups: { label: string; entries: Entry[] }[] = [];
for (const entry of earlier) {
  const label = entry.data.sprint ? `Sprint ${entry.data.sprint}` : "Before Sprint 1";
  const group = groups.find((g) => g.label === label);
  if (group) group.entries.push(entry);
  else groups.push({ label, entries: [entry] });
}
---

<Base description="Progress, decisions and blockers on GeekyKey, written up for our capstone mentors before each check-in.">
  <section class="pb-12 pt-10 md:pb-16 md:pt-20">
    <h1 class="max-w-[20ch] text-4xl font-semibold leading-[1.1] tracking-tight md:text-5xl">
      What we’ve been doing between check-ins
    </h1>
    <p class="mt-5 max-w-[52ch] text-lg leading-relaxed text-muted-foreground">
      Progress, decisions and blockers on GeekyKey, written up for our mentors before each
      check-in. Newest first.
    </p>
  </section>

  <Schedule asOf={latest?.data.date} />

  {
    latest ? (
      <section
        aria-labelledby="latest-title"
        class="mt-12 grid gap-x-12 gap-y-4 border-t border-border pt-10 md:mt-16 md:grid-cols-[11rem_minmax(0,1fr)]"
      >
        <div class="text-sm">
          <p class="text-muted-foreground">Latest update</p>
          <p class="mt-1 font-mono">
            <time datetime={isoDay(latest.data.date)}>
              {formatRange(latest.data.window.from, latest.data.window.to)}
            </time>
          </p>
          {latest.data.sprint && (
            <p class="font-mono text-muted-foreground">Sprint {latest.data.sprint}</p>
          )}
        </div>
        <div class="max-w-[68ch]">
          <h2 id="latest-title" class="text-2xl font-semibold leading-tight tracking-tight md:text-3xl">
            {latest.data.title}
          </h2>
          <p class="mt-4 text-lg leading-relaxed">{latest.data.summary}</p>
          <p class="mt-3 text-sm text-muted-foreground">
            Written by {formatList(latest.data.authors.map((a) => TEAM[a]))}
          </p>
          {latest.data.asks && <Asks asks={latest.data.asks} level={3} class="mt-8" />}
          <a href={`/entries/${latest.id}/`} class="button-primary mt-8">
            Read the full update
          </a>
        </div>
      </section>
    ) : (
      <section class="mt-12 border-t border-border pt-10 md:mt-16">
        <h2 class="text-2xl font-semibold tracking-tight">No updates yet</h2>
        <p class="mt-3 max-w-[52ch] text-muted-foreground">
          The first one goes up before the next mentor check-in.
        </p>
      </section>
    )
  }

  {
    groups.length > 0 && (
      <section aria-labelledby="earlier-title" class="mt-16 border-t border-border pt-10">
        <h2 id="earlier-title" class="text-2xl font-semibold tracking-tight">
          Earlier updates
        </h2>
        {groups.map((group) => (
          <section class="mt-8" aria-label={group.label}>
            <h3 class="text-sm font-medium text-muted-foreground">{group.label}</h3>
            <ol class="mt-2">
              {group.entries.map((entry) => (
                <li class="grid gap-x-12 gap-y-1 py-4 md:grid-cols-[11rem_minmax(0,1fr)]">
                  <p class="font-mono text-sm text-muted-foreground">
                    <time datetime={isoDay(entry.data.date)}>
                      {formatRange(entry.data.window.from, entry.data.window.to)}
                    </time>
                  </p>
                  <div class="max-w-[68ch]">
                    <a
                      href={`/entries/${entry.id}/`}
                      class="font-semibold underline-offset-4 hover:underline"
                    >
                      {entry.data.title}
                    </a>
                    <p class="mt-1 text-muted-foreground">{entry.data.summary}</p>
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </section>
    )
  }
</Base>
