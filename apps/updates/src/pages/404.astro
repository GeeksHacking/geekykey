---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page does not exist.">
  <section class="pt-10 md:pt-20">
    <h1 class="text-3xl font-semibold tracking-tight md:text-4xl">This page does not exist</h1>
    <p class="mt-4 max-w-[52ch] text-lg text-muted-foreground">
      The link may be old, or the update it pointed to may have been renamed.
    </p>
    <a href="/" class="button-primary mt-8">All updates</a>
  </section>
</Base>
