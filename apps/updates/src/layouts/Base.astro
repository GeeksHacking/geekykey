---
import "@fontsource-variable/open-sans";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";

import { formatList } from "../lib/format";
import { TEAM } from "../lib/project";

interface Props {
  /** The page's own title. Leave it out on the home page. */
  title?: string;
  description: string;
}

const { title, description } = Astro.props;
const siteName = "GeekyKey updates";

// Entry pages count as Updates, so the nav still says where you are inside one.
const path = Astro.url.pathname;
const nav = [
  { href: "/", label: "Updates", here: path === "/" || path.startsWith("/entries/") },
  { href: "/changelog/", label: "Changelog", here: path.startsWith("/changelog") },
];

---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} | ${siteName}` : siteName}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={title ? "article" : "website"} />
    <link rel="icon" type="image/svg+xml" href="/brand/gh-logo-secondary.svg" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:rounded-md focus:bg-card focus:px-4 focus:py-2"
    >
      Skip to content
    </a>
    <div class="mx-auto flex min-h-[100dvh] max-w-6xl flex-col px-5 md:px-8">
      <header class="flex h-16 items-center justify-between gap-6">
        {/* The kit's secondary logo beside the product name, as in the screens' wordmark. */}
        <a href="/" class="inline-flex items-center gap-2 text-lg">
          <img src="/brand/gh-logo-secondary.svg" alt="" class="h-5 w-auto" />
          <span class="font-bold tracking-[0.02em]">GeekyKey</span>
          <span class="hidden text-muted-foreground sm:inline">Updates</span>
        </a>
        <nav aria-label="Site" class="flex gap-1 text-sm sm:gap-2">
          {
            nav.map((link) => (
              <a
                href={link.href}
                aria-current={link.here ? "page" : undefined}
                class:list={[
                  "rounded-md px-2.5 py-1.5 font-medium transition-colors sm:px-3",
                  /* The kit marks the current page as a solid yellow segment, as the screens' nav does. */
                  link.here
                    ? "bg-primary text-primary-foreground inset-ring inset-ring-primary-edge"
                    : "text-muted-foreground hover:text-foreground",
                ]}
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </header>
      <main id="main" class="flex-1 pb-20">
        <slot />
      </main>
      <footer class="border-t border-border py-8 text-sm text-muted-foreground">
        <p class="max-w-[70ch]">
          GeekyKey is an SST Di'SPARK capstone project with Ngee Ann Polytechnic and
          GeeksHacking, built by {formatList(Object.values(TEAM))}.
        </p>
      </footer>
    </div>
  </body>
</html>
