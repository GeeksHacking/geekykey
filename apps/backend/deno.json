{
  "name": "@geekykey/backend",
  "version": "0.1.0",
  "exports": "./mod.ts",
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "tasks": {
    "dev": "DEV_AUTH_ENABLED=true deno run --watch --allow-net --allow-read --allow-write --allow-env --allow-ffi src/index.ts",
    "start": "deno run --allow-net --allow-read --allow-write --allow-env --allow-ffi src/index.ts",
    "seed": "DEV_AUTH_ENABLED=true deno run --allow-net --allow-read --allow-write --allow-env --allow-ffi scripts/seed.ts",
    "test": "deno test --allow-net --allow-read --allow-write --allow-env --allow-ffi",
    "check": "deno check src scripts drizzle.config.ts",
    "db:generate": "deno run -A npm:drizzle-kit generate"
  },
  "nodeModulesDir": "auto",
  "license": "MIT"
}
