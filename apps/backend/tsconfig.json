{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Node's types for nodejs_compat and the scripts; the Workers runtime's
    // come from worker-configuration.d.ts, which `wrangler types` writes.
    "types": ["node", "@cloudflare/vitest-plugin/types"],
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "worker-configuration.d.ts",
    "src",
    "scripts/*.ts",
    "test-support/*.ts",
    "drizzle.config.ts",
    "vitest.config.ts"
  ]
}
