{
  "name": "@geekykey/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch scripts/dev-server.ts",
    "test": "vitest run",
    "build": "rolldown src/server.ts --platform node --format cjs --sourcemap --file dist/server.cjs",
    "build:image": "docker build --file Dockerfile --tag geekykey-backend ../..",
    "typecheck": "tsc",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:migrations": "node scripts/check-migrations.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.ts",
    "db:logins": "node scripts/create-logins.ts",
    "db:test-station": "node scripts/create-test-station.ts",
    "seed": "node scripts/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.7.6",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "mysql2": "^3.24.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "0.70.0",
    "oxlint": "1.87.0",
    "rolldown": "1.2.12",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
