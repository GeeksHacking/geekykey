{
  "name": "@geekykey/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=dev.env --env-file-if-exists=.env src/server.ts",
    "test": "vitest run",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node24 --sourcemap --outfile=dist/server.cjs",
    "build:image": "docker build --file Dockerfile --tag geekykey-backend ../..",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:migrations": "node scripts/check-migrations.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.ts",
    "db:logins": "node scripts/create-logins.ts",
    "db:test-station": "node scripts/create-test-station.ts",
    "seed": "node scripts/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.7.6",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "mysql2": "^3.24.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "oxfmt": "0.70.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
