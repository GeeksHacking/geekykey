{
  "name": "@geekykey/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var DEV_AUTH_ENABLED:true",
    "test": "vitest run",
    "typecheck": "wrangler types && tsc",
    "lint": "eslint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:build": "wrangler deploy --dry-run",
    "check:migrations": "node scripts/check-migrations.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.ts",
    "db:logins": "node scripts/create-logins.ts",
    "db:test-station": "node scripts/create-test-station.ts",
    "seed": "node scripts/seed.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "mysql2": "^3.24.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "oxfmt": "0.70.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.0"
  }
}
