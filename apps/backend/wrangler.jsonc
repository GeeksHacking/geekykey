// The GeekyKey Service as a Cloudflare Worker. `wrangler dev` runs it locally
// on workerd, the runtime Cloudflare runs in production.
//
// Settings live here and change through a reviewed pull request. Secrets never
// do: locally they go in the gitignored .dev.vars (copy .dev.vars.example), and
// in production they're set with `wrangler secret put`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geekykey-service",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-26",
  // mysql2 needs Node's networking APIs.
  "compatibility_flags": ["nodejs_compat"],
  // Wrangler sends anonymous usage data unless told not to.
  "send_metrics": false,

  // No workers.dev address and no preview URLs: the custom domain, added at
  // the first deploy, is the only way in.
  "workers_dev": false,
  "preview_urls": false,

  // The port today's backend uses, so the frontend's Vite proxy and the
  // stations don't change. Every network interface, not only localhost,
  // because real stations call this laptop by name, such as
  // http://A-Mac.local:8000.
  "dev": {
    "ip": "0.0.0.0",
    "port": 8000,
  },

  "vars": {
    "TAP_COOLDOWN_SECONDS": "300",
    "MAX_TAPS_PER_REQUEST": "500",
  },

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // A stand-in until the production Hyperdrive config is created at the
      // first deploy. `wrangler dev` and the tests never use it.
      "id": "00000000000000000000000000000000",
      // `wrangler dev` connects straight to the TiDB from `mise run db:up`,
      // and a deploy leaves this out. The login isn't a secret: it only works
      // on this machine. The tests use geekykey_test instead (vitest.config.ts).
      "localConnectionString": "mysql://geekykey:geekykey@127.0.0.1:4000/geekykey_dev",
    },
  ],
}
