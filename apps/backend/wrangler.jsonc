// The GeekyKey Service as a Cloudflare Worker. `wrangler dev` runs it locally
// on workerd, the runtime Cloudflare runs in production.
//
// Settings live here and change through a reviewed pull request. This file is
// the source of truth: a deploy overwrites settings and routes changed in the
// Cloudflare dashboard. Secrets never live here: locally they go in the
// gitignored .dev.vars (copy .dev.vars.example), and in production they're set
// on the Worker itself.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geekykey-service",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-26",
  // mysql2 needs Node's networking APIs.
  "compatibility_flags": ["nodejs_compat"],
  // Wrangler sends anonymous usage data unless told not to.
  "send_metrics": false,

  // No workers.dev address and no preview URLs: the custom domain below is
  // the only way in.
  "workers_dev": false,
  "preview_urls": false,

  // The address stations and Event Services call. Julian attached it in the
  // dashboard first. It's listed here too, so a deploy keeps it.
  "routes": [{ "pattern": "key-api.geekshacking.com", "custom_domain": true }],

  // Secrets the Worker can't start without in production: a deploy fails if
  // one isn't set on the Worker. Listing them also changes `wrangler dev`: from
  // .dev.vars it now takes only these and the settings under `vars`, and
  // ignores anything else, such as DEV_AUTH_ENABLED.
  "secrets": {
    "required": ["SESSION_SECRET"],
  },

  // Logs every request, with its CPU time, to Workers Logs. New Workers have
  // this on anyway, but checking what the logs hold and measuring CPU time both
  // depend on it, so it's written down rather than left to a default.
  "observability": {
    "enabled": true,
  },

  // The port today's backend uses, so the frontend's Vite proxy and the
  // stations don't change. Every network interface, not only localhost,
  // because real stations call this laptop by name, such as
  // http://A-Mac.local:8000.
  "dev": {
    "ip": "0.0.0.0",
    "port": 8000,
  },

  "vars": {
    "TAP_COOLDOWN_SECONDS": "300",
    "MAX_TAPS_PER_REQUEST": "500",
  },

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // A stand-in until the production Hyperdrive config is created at the
      // first deploy. `wrangler dev` and the tests never use it.
      "id": "00000000000000000000000000000000",
      // `wrangler dev` connects straight to the TiDB from `mise run db:up`,
      // and a deploy leaves this out. The login isn't a secret: it only works
      // on this machine. The tests use geekykey_test instead (vitest.config.ts).
      "localConnectionString": "mysql://geekykey:geekykey@127.0.0.1:4000/geekykey_dev",
    },
  ],

  // Staging: a copy on Adam's own free Cloudflare account, against
  // geekykey_staging, where deploys are tried and logs read before production.
  // Only `pnpm deploy:staging` deploys it. Everything above is production's,
  // which Workers Builds deploys with a plain `wrangler deploy`, so it never
  // sees this.
  "env": {
    "staging": {
      "name": "geekykey-service-staging",
      // Adam's account, so a staging deploy can't land in anyone else's.
      "account_id": "STAND-IN-ACCOUNT-ID",
      // No domain: it answers at its workers.dev address. Routes are passed
      // down from the top level, so this clears production's.
      "workers_dev": true,
      "routes": [],

      // Settings, secrets and bindings aren't passed down, so they're repeated
      // here. The settings are production's, so staging behaves like it.
      "secrets": {
        "required": ["SESSION_SECRET"],
      },
      "vars": {
        "TAP_COOLDOWN_SECONDS": "300",
        "MAX_TAPS_PER_REQUEST": "500",
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          // Staging's Hyperdrive config, in Adam's account, with the query
          // cache off.
          "id": "STAND-IN-HYPERDRIVE-ID",
        },
      ],
    },
  },
}
