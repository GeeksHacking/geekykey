# The Google Cloud project the Event Service runs in, read by
# .github/workflows/deploy.yml. None of these is a secret: they say where
# things are, and only the keyless sign-in in infra/README.md (step 6)
# decides who may use them. One NAME=value a line, with no quotes and no
# comment after a value, because GitHub reads this file as it is.

PROJECT_ID=geekykey-b035a
REGION=asia-southeast1

# The keyless sign-in's provider, which trusts GitHub's tokens from this repo
# (the number is the project's number, not its ID).
WORKLOAD_IDENTITY_PROVIDER=projects/468223998400/locations/global/workloadIdentityPools/github/providers/geekykey

# Where each image is pushed, in the image repository from step 2. Each one is
# tagged with the commit it was built from.
IMAGE=asia-southeast1-docker.pkg.dev/geekykey-b035a/event-service/event-service
