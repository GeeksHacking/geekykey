# event-service's settings. The deploy sets exactly these on Cloud Run
# (gcloud run deploy --env-vars-file), and removes any other, so a setting
# changes here, through a reviewed pull request. apps/event-service/src/
# config.ts says what each one does.
#
# Never put a secret here: secrets are pinned in deploy.env. Cloud Run sets
# PORT itself.

TAP_COOLDOWN_SECONDS=300
DEV_AUTH_ENABLED=false

# Who may use the organizers' screens, by user ID, separated by commas. It
# starts empty, which means nobody. It's read when the server starts, so a
# change takes a deploy.
ORGANIZERS=
