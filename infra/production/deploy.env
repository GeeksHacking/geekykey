# What .github/workflows/deploy.yml deploys production with, on every push to main.
# One NAME=value a line, with no quotes and no comment after a value,
# because GitHub reads this file as it is.

# The Cloud Run service, and the account the deploy signs in as to reach it.
SERVICE=event-service
DEPLOYER=event-service-deployer@geekykey-b035a.iam.gserviceaccount.com

# Each secret the service reads, as NAME=secret:version, given to the server
# as the environment variable NAME. There's one: APP_SECRETS, a JSON object
# holding SESSION_SECRET, DATABASE_URL, EVENT_SERVICE_KEY and
# CLAIMS_STAND_IN_KEY, which the server unpacks. To change any of them, add a
# new version in Secret Manager (infra/README.md, "Changing a secret"), then
# change its number here.
SECRETS=APP_SECRETS=event-service-app-secrets:1

# The migration login, as secret:version. Only the deploy reads it, to run
# db:migrate. The server never gets it.
MIGRATION_SECRET=event-service-migration-database-url:1
