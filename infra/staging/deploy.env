# What .github/workflows/deploy.yml deploys staging with, on a run by hand
# (workflow_dispatch), from any branch.
# One NAME=value a line, with no quotes and no comment after a value,
# because GitHub reads this file as it is.

# The Cloud Run service, and the account the deploy signs in as to reach it.
SERVICE=event-service-staging
DEPLOYER=event-service-staging-deployer@geekykey-b035a.iam.gserviceaccount.com

# Each secret the service reads, as NAME=secret:version, given to the server
# as the environment variable NAME. To change one, add a new version in Secret
# Manager (infra/README.md, "Changing a secret"), then change its number here.
SECRETS=SESSION_SECRET=event-service-staging-session-secret:1,DATABASE_URL=event-service-staging-database-url:2

# The migration login, as secret:version. Only the deploy reads it, to run
# db:migrate. The server never gets it.
MIGRATION_SECRET=event-service-staging-migration-database-url:1
