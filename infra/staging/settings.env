# event-service-staging's settings. The deploy sets exactly these on Cloud Run
# (gcloud run deploy --env-vars-file), and removes any other, so a setting
# changes here, through a reviewed pull request. apps/backend/src/config.ts
# says what each one does.
#
# Never put a secret here: secrets are pinned in deploy.env. Cloud Run sets
# PORT itself.

TAP_COOLDOWN_SECONDS=300
MAX_TAPS_PER_REQUEST=500
TAP_DEADLINE_MS=4000
DEV_AUTH_ENABLED=false

# Where the GeekyKey side hands a station's taps: one Event Service, the
# showcase. Inside this one server the hand-off never leaves it, but it's
# sent to this address, as it will be once the two services run apart.
EVENT_SERVICES='[{"id":"showcase","name":"Capstone Showcase","url":"https://event-service-staging-468223998400.asia-southeast1.run.app"}]'

# Who may use the organizers' screens, and who may release someone else's
# token, by user ID, separated by commas. Both start empty, which means
# nobody. Each is read when the server starts, so a change takes a deploy.
ORGANIZERS=
GEEKYKEY_ADMINS=
