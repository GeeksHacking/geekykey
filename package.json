{
  "name": "geekykey",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:backend": "pnpm --filter @geekykey/backend dev",
    "test:backend": "pnpm --filter @geekykey/backend test",
    "format:backend": "pnpm --filter @geekykey/backend format",
    "db:up": "docker compose up --detach --wait && node apps/backend/scripts/create-databases.ts && pnpm db:migrate",
    "db:reset": "docker compose down && pnpm db:up",
    "db:down": "docker compose stop",
    "db:migrate": "pnpm --filter @geekykey/backend db:migrate",
    "seed": "pnpm --filter @geekykey/backend seed",
    "dev:frontend": "pnpm --filter @geekykey/frontend dev",
    "build:frontend": "pnpm --filter @geekykey/frontend build",
    "test:frontend": "pnpm --filter @geekykey/frontend test",
    "format:frontend": "pnpm --filter @geekykey/frontend format",
    "dev:updates": "pnpm --filter @geekykey/updates dev",
    "build:updates": "pnpm --filter @geekykey/updates build"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
