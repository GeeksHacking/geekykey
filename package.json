{
  "name": "geekykey",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "VITE_LIVE_API=1 pnpm --parallel --filter @geekykey/geekykey-service --filter @geekykey/event-service --filter @geekykey/event-web --filter @geekykey/geekykey-web dev",
    "dev:event-service": "pnpm --filter @geekykey/event-service dev",
    "test:event-service": "pnpm --filter @geekykey/event-service test",
    "format:event-service": "pnpm --filter @geekykey/event-service format",
    "db:up": "docker compose up --detach --wait && node apps/event-service/scripts/create-databases.ts && pnpm db:migrate",
    "db:reset": "docker compose down && pnpm db:up",
    "db:down": "docker compose stop",
    "db:migrate": "pnpm --filter @geekykey/event-service db:migrate",
    "seed": "pnpm --filter @geekykey/event-service seed",
    "dev:geekykey-service": "pnpm --filter @geekykey/geekykey-service dev",
    "test:geekykey-service": "pnpm --filter @geekykey/geekykey-service test",
    "format:geekykey-service": "pnpm --filter @geekykey/geekykey-service format",
    "test:smoke": "pnpm --filter @geekykey/event-service test:smoke",
    "dev:event-web": "pnpm --filter @geekykey/event-web dev",
    "build:event-web": "pnpm --filter @geekykey/event-web build",
    "test:event-web": "pnpm --filter @geekykey/event-web test",
    "format:event-web": "pnpm --filter @geekykey/event-web format",
    "dev:geekykey-web": "pnpm --filter @geekykey/geekykey-web dev",
    "build:geekykey-web": "pnpm --filter @geekykey/geekykey-web build",
    "test:geekykey-web": "pnpm --filter @geekykey/geekykey-web test",
    "format:geekykey-web": "pnpm --filter @geekykey/geekykey-web format",
    "test:setup-page": "pnpm --filter @geekykey/setup-page test",
    "format:setup-page": "pnpm --filter @geekykey/setup-page format",
    "dev:updates": "pnpm --filter @geekykey/updates dev",
    "build:updates": "pnpm --filter @geekykey/updates build"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
